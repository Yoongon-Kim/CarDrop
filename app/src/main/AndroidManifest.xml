<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- AI calls, crew sync and map tiles -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Board 09's 녹음해서 보내기 (Member A, 2026-11-15): a voice message of at most 20 s, asked for on first use. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- GPS for the in-app navigator (asked at first launch). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Public AAOS speed for acceleration/braking records. -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Vehicle position for the crew diagram; requested at runtime on supported Pleos devices. -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />

    <!-- The real voice (cardrop.useRealVoice=true): the Pleos speech service, used through the Pleos
         TextToSpeech and SpeechToText SDKs (protectionLevel="normal", no prompt). The Pleos service
         records the microphone itself, so CarDrop needs no microphone permission. -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />

    <!-- Pleos Vehicle Service read permissions (protectionLevel="normal").
         CarDrop only reads car data; it never controls the car. -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_MILEAGE" />
    <uses-permission android:name="pleos.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="pleos.car.permission.CAR_SPEED" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />

    <application
        android:name=".CarDropApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CarDrop">
        <uses-library android:name="android.car" android:required="false" />
        <service android:name=".safety.SafetyRecordingService" android:exported="false" android:foregroundServiceType="location" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CarDrop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
